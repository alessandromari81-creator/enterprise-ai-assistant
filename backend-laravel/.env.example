APP_NAME="Enterprise AI Assistant (Laravel)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Con "php artisan serve": più worker, altrimenti un'ingestione lunga blocca tutte le altre richieste.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: PostgreSQL + pgvector (docker-compose.yml nella root) -------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eaa
DB_USERNAME=eaa
DB_PASSWORD=eaa

# --- API pura: niente sessioni, cache o code su database -------------------------------
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- CORS: origine di Angular (ng serve). Più origini separate da virgola --------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- AI (Prism) ------------------------------------------------------------------------
# Provider: "ollama" (locale, docker compose --profile ollama up -d) oppure "openai".
AI_PROVIDER=ollama
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBEDDING_MODEL=nomic-embed-text
# DEVE coincidere con VECTOR(n) nello schema. nomic-embed-text = 768.
AI_EMBEDDING_DIMENSIONS=768

# Ollama
OLLAMA_URL=http://localhost:11434

# OpenAI (se AI_PROVIDER=openai). Esempio:
#   AI_PROVIDER=openai
#   AI_CHAT_MODEL=gpt-4o-mini
#   AI_EMBEDDING_MODEL=text-embedding-3-small
#   (le dimensioni vengono ridotte a 768 automaticamente)
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1

# Un LLM locale può impiegare più di 30 s (default di Prism): alzo il timeout (secondi).
PRISM_REQUEST_TIMEOUT=180

# --- Parametri RAG (identici nel backend Spring Boot) ----------------------------------
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=5
RAG_MIN_SCORE=0.62
