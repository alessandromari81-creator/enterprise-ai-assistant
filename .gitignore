# ======================================================================================
# Enterprise AI Assistant — .gitignore del monorepo
# Regola d'oro: niente segreti, niente dipendenze, niente file generati o temporanei.
# Ogni sottoprogetto ha anche il proprio .gitignore (Laravel, Angular, Spring): questo è la rete di sicurezza.
# ======================================================================================

# --- Segreti e configurazione locale ------------------------------------------------------------
# I file .env contengono chiavi API (OPENAI_API_KEY...) e password: MAI nel repository.
# Si versiona solo l'esempio (.env.example).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
credentials*.json
secrets*

# --- Dipendenze installate -------------------------------------------------------------------------
node_modules/
vendor/
.pnpm-store/

# --- Build e cache --------------------------------------------------------------------------------
dist/
build/
out/
target/
.angular/
.gradle/
.mvn/wrapper/maven-wrapper.jar
bootstrap/cache/*
!bootstrap/cache/.gitignore

# --- Laravel: file generati a runtime -----------------------------------------------------------------
backend-laravel/storage/logs/*
backend-laravel/storage/framework/cache/data/*
backend-laravel/storage/framework/sessions/*
backend-laravel/storage/framework/views/*
backend-laravel/storage/framework/testing/*
backend-laravel/storage/app/private/*
backend-laravel/storage/app/public/*
backend-laravel/public/storage
backend-laravel/public/hot
.phpunit.cache/
.phpunit.result.cache
*.sqlite
*.sqlite3

# --- Log, temporanei, risultati di test ----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
*.tmp
*.temp
*.bak
*.swp
*~
tmp/
temp/
coverage/
test-results/
playwright-report/
.vitest/
hs_err_pid*

# --- Dati locali di Docker -----------------------------------------------------------------------------
# I volumi (pgdata, ollama) vivono dentro Docker, non nel repository.
*.dump
pgdata/

# --- Editor e sistema operativo -------------------------------------------------------------------------
.DS_Store
.AppleDouble
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath
.history/
